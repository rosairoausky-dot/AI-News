{
  "manifest_version": 3,
  "name": "AI Frontier Atlas 社媒采集器",
  "version": "1.0.0",
  "description": "在用户已登录且主动点击采集时读取当前可见社交媒体内容，并发送到本地 AI Frontier Atlas。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*", "https://www.xiaohongshu.com/*", "https://mp.weixin.qq.com/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
